# Supabase — lấy ở Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Connection string cho drizzle-kit (Settings → Database).
# Dùng SESSION POOLER, không dùng chuỗi kết nối trực tiếp:
#   - direct (db.<ref>.supabase.co) chỉ có bản ghi IPv6, mạng không có IPv6 là
#     không nối được;
#   - session pooler (aws-<n>-<region>.pooler.supabase.com) có IPv4 và vẫn hỗ
#     trợ prepared statement, thứ mà drizzle-kit cần.
# Dạng: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

NEXT_PUBLIC_APP_URL=

GOOGLE_GENERATIVE_AI_API_KEY=

# Chỉ dùng cho db/__tests__/rls.test.ts. Thiếu thì bài test tự bỏ qua — mà bỏ
# qua thì trông y hệt pass, nên hãy điền nếu muốn policy thật sự được kiểm.
RLS_TEST_USER_A_EMAIL=
RLS_TEST_USER_A_PASSWORD=
RLS_TEST_USER_B_EMAIL=
RLS_TEST_USER_B_PASSWORD=
